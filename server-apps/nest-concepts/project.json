{
  "name": "nest-concepts",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "server-apps/nest-concepts/src",
  "projectType": "application",
  "tags": [],
  "targets": {
    "serve": {
      "executor": "@nx/js:node",
      "defaultConfiguration": "development",
      "dependsOn": ["build"],
      "watch": true,
      "options": {
        "buildTarget": "nest-concepts:build",
        "runBuildTargetDependencies": false
      },
      "configurations": {
        "development": {
          "buildTarget": "nest-concepts:build:development"
        },
        "production": {
          "buildTarget": "nest-concepts:build:production"
        }
      }
    },
    "build": {
      "outputs": ["{workspaceRoot}/dist/server-apps/nest-concepts", "{projectRoot}/dist"],
      "defaultConfiguration": "development",
      "configurations": {
        "development": {},
        "production": {}
      }
    },
    "serve-hmr": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "server-apps/nest-concepts",
        "commands": ["nest build --webpack --webpackPath webpack-hmr.config.js --watch"]
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "server-apps/nest-concepts",
        "commands": [
          "tsc -p tsconfig.app.json --noEmit",
          "tsc -p tsconfig.spec.json --noEmit"
        ]
      }
    }
  }
}
