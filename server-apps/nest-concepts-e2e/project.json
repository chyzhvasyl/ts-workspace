{
  "name": "nest-concepts-e2e",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "implicitDependencies": ["nest-concepts"],
  "targets": {
    "e2e": {
      "outputs": [
        "{workspaceRoot}/coverage/{e2eProjectRoot}",
        "{workspaceRoot}/coverage/nest-concepts-e2e"
      ],
      "dependsOn": ["nest-concepts:build"],
      "options": {
        "passWithNoTests": true
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "server-apps/nest-concepts-e2e",
        "command": "tsc -p tsconfig.spec.json --noEmit"
      }
    }
  }
}
