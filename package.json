{
  "name": "ts-workspace",
  "version": "1.0.0",
  "scripts": {
    "react-app:start": "nx serve react-concepts",
    "react-app:build": "nx build react-concepts",
    "fintech-app:serve": "nx serve fintech-playground",
    "nest-app:serve": "nx serve nest-concepts",
    "nest-app:hot-serve": "nx run nest-concepts:serve-hmr",
    "nest-app:build": "nx build nest-concepts",
    "ts-app:run": "nx run algorithm-training:start",
    "e2e:playwright": "nx e2e react-concepts-playwright-e2e",
    "e2e:playwright:ui": "nx e2e react-concepts-playwright-e2e --ui",
    "e2e:cypress": "start-server-and-test react-app:start http://localhost:4200 cypress:open",
    "e2e:cypress:run": "nx e2e react-concepts-cypress-e2e",
    "cypress:open": "cypress open",
    "cypress:run": "cypress run",
    "lint:fix": "nx run-many -t lint --fix",
    "lint:styles": "stylelint \"**/*.{css,scss}\" --fix",
    "format:write": "nx format:write --all --verbose",
    "format:check": "nx format:check --all",
    "prepare-pr": "nx format:write && nx affected -t lint --fix && npm run lint:styles && nx format:write && nx affected -t build",
    "prepare-pr:all": "npm run format:write && npm run lint:fix && npm run lint:styles && npm run format:write && nx run-many -t build",
    "openspec:validate": "openspec validate --all --strict",
    "openspec:update": "openspec update"
  },
